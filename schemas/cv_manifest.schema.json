{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cv_manifest.schema.json",
  "title": "COTA cross-validation manifest row",
  "type": "object",
  "additionalProperties": false,
  "required": ["patient_key", "fold", "exclusion_group", "reviewer_consensus_lot"],
  "properties": {
    "patient_key": {"type": "string", "pattern": "^COTAOLD-[0-9a-f]{20}$"},
    "fold": {"type": "integer", "minimum": 0},
    "exclusion_group": {"type": "string", "pattern": "^EXCL-[0-9a-f]{20}$"},
    "reviewer_consensus_lot": {"type": "integer", "minimum": 0}
  }
}
